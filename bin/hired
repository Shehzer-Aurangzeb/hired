#!/usr/bin/env bash
#
# Start hired and open it. `hired help` lists the commands.

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
BACKEND="$ROOT/backend"
BUNDLE="$ROOT/frontend/dist/hired/browser"
PORT="${HIRED_PORT:-8000}"
URL="http://127.0.0.1:$PORT"
PIDFILE="$BACKEND/.hired.pid"
LOGFILE="$BACKEND/.hired.log"
ENVFILE="$BACKEND/.env"

# Keep Playwright's browser out of ~/Library/Caches, which macOS cleanup deletes.
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.playwright}"

# Docker mode when there is no local Python setup, or when HIRED_DOCKER=1.
DOCKER=
if [ -n "${HIRED_DOCKER:-}" ] || { [ ! -x "$BACKEND/.venv/bin/python" ] && command -v docker >/dev/null; }; then
  DOCKER=1
fi
compose() { docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" "$@"; }

open_url() {
  if command -v open >/dev/null; then open "$1"
  elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1
  fi || true
}

running() {
  if [ -n "$DOCKER" ]; then [ -n "$(compose ps -q --status running 2>/dev/null)" ]
  else [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
  fi
}

# True when frontend node_modules is installed.
deps() { [ -x "$ROOT/frontend/node_modules/.bin/ng" ]; }

# True when Playwright's Chromium launches (needed for PDF export).
browser() {
  "$BACKEND/.venv/bin/python" -c \
    'from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    p.chromium.launch().close()' 2>/dev/null
}

stop() {
  if [ -n "$DOCKER" ]; then compose stop >/dev/null 2>&1 || true; return; fi
  if running; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    # Wait up to 2s for a clean exit, then force it.
    for _ in $(seq 20); do running || break; sleep 0.1; done
    running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
}

# Read or replace KEY=value in backend/.env.
env_get() { sed -n "s/^$1=//p" "$ENVFILE" | tail -1 | tr -d "'\""; }
env_set() {
  local tmp; tmp="$(mktemp)"
  grep -v "^$1=" "$ENVFILE" > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$ENVFILE"
}

setup() {
  if [ ! -f "$ENVFILE" ]; then
    cp "$BACKEND/.env.example" "$ENVFILE"
    echo "created backend/.env"
  fi

  if [ -z "$(env_get HIRED_SECRET_KEY)" ]; then
    env_set HIRED_SECRET_KEY "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 64)"
    echo "secret key   generated"
  else
    echo "secret key   already set"
  fi

  if [ -z "$(env_get HIRED_PASSWORD_HASH)" ]; then
    local pw again hash
    read -r -s -p "Choose the password that unlocks hired (12+ characters): " pw; echo
    [ "${#pw}" -ge 12 ] || { echo "Use at least 12 characters." >&2; exit 1; }
    read -r -s -p "Again: " again; echo
    [ "$pw" = "$again" ] || { echo "Those do not match." >&2; exit 1; }
    # The password goes in on stdin, so it never appears in a process list.
    local code='import sys; from app.auth import hash_password; print(hash_password(sys.stdin.read()))'
    if [ -n "$DOCKER" ]; then
      hash="$(printf '%s' "$pw" | compose run --rm --no-deps -T hired python -c "$code")"
    else
      hash="$(cd "$BACKEND" && printf '%s' "$pw" | .venv/bin/python -c "$code")"
    fi
    # Single quotes stop Docker Compose expanding the $ signs in the hash.
    env_set HIRED_PASSWORD_HASH "'$hash'"
    echo "password     set"
  else
    echo "password     already set"
  fi

  if [ -z "$(env_get HIRED_GEMINI_API_KEY)" ]; then
    local key
    read -r -p "Gemini API key from aistudio.google.com (Enter to skip): " key
    if [ -n "$key" ]; then env_set HIRED_GEMINI_API_KEY "$key"; echo "gemini key   set"; fi
  fi
  echo "done. Run: hired"
}

usage() {
  cat <<TXT
hired — tailor a CV to a job posting, on your own machine.

  hired setup      create backend/.env: secret key, password, API key
  hired            start it and open the browser
                   (already running? just opens the tab)
  hired stop       stop it
  hired restart    stop, then start
  hired status     is it up, and on what
  hired log        follow the log, Ctrl-C to stop watching
  hired backup     copy the database and profile into backend/backups
  hired doctor     check the pieces that go missing without telling you
  hired help       this

Working on hired (needs backend/.venv, not Docker)
  hired dev        start it, then ng serve on 4200 for front-end work
  hired demo       an invented profile on port 8001, for screenshots

How it runs
  With backend/.venv present it runs locally: one process on one port,
  FastAPI serving the built Angular bundle. Without it, and with Docker
  installed, the same commands run it in Docker instead. HIRED_DOCKER=1
  forces Docker mode.

  It listens on 127.0.0.1 only, so nothing else on your network can
  reach it. The database holds your profile and every CV you have sent.

  Port $PORT, override with HIRED_PORT. Secrets come from
  backend/.env and are never passed on the command line.

  Mode    $([ -n "$DOCKER" ] && echo docker || echo local)
  Repo    $ROOT
TXT
}

status() {
  if ! running; then echo "not running"
  elif [ -n "$DOCKER" ]; then echo "running in docker on $URL"
  else echo "running on $URL   (pid $(cat "$PIDFILE"))"
  fi
}

# Poll /api/health (no session needed) until it answers or $1 tenths of a second pass.
wait_up() {
  for _ in $(seq "$1"); do
    curl -fsS --max-time 1 "$URL/api/health" >/dev/null 2>&1 && return 0
    running || return 1
    sleep 0.1
  done
  return 1
}

docker_main() {
  case "${1:-start}" in
    stop) stop; echo "stopped"; exit 0 ;;
    status) status; exit 0 ;;
    log) compose logs -f hired; exit 0 ;;
    backup)
      compose exec hired python tools/backup.py /data/backups
      mkdir -p "$BACKEND/backups"
      compose cp hired:/data/backups/. "$BACKEND/backups/"
      echo "copied into $BACKEND/backups"
      exit 0 ;;
    doctor)
      bad=0
      if docker info >/dev/null 2>&1; then echo "docker    ok"
      else echo "docker    NOT RUNNING  start Docker Desktop or the docker service"; bad=1; fi
      if [ -f "$ENVFILE" ]; then echo ".env      ok"
      else echo ".env      MISSING  hired setup"; bad=1; fi
      if running; then echo "container running"; else echo "container stopped, hired starts it"; fi
      exit $bad ;;
    dev|demo) echo "hired $1 needs the local setup (backend/.venv), not Docker." >&2; exit 1 ;;
    restart|start) ;;
  esac

  [ -f "$ENVFILE" ] || { echo "No backend/.env yet. Run: hired setup" >&2; exit 1; }
  docker info >/dev/null 2>&1 || { echo "Docker is not running. Start it and try again." >&2; exit 1; }

  [ "${1:-start}" = restart ] && stop
  if running; then
    echo "already running on $URL"
    open_url "$URL"
    exit 0
  fi

  echo "starting in docker (the first build takes a few minutes)..."
  compose up -d --build
  if wait_up 600; then
    open_url "$URL"
    echo "hired is up on $URL   (hired stop | hired log)"
    exit 0
  fi
  echo "did not come up:" >&2; compose logs --tail 20 hired >&2; exit 1
}

case "${1:-start}" in
  setup) setup; exit 0 ;;
  help|-h|--help) usage; exit 0 ;;
  start|stop|restart|status|log|dev|demo|backup|doctor) ;;
  *) echo "hired: no such command '$1'" >&2; echo >&2; usage >&2; exit 2 ;;
esac

[ -n "$DOCKER" ] && docker_main "${1:-start}"

case "${1:-start}" in
  stop) stop; echo "stopped"; exit 0 ;;
  status) status; exit 0 ;;
  log)  [ -f "$LOGFILE" ] || { echo "no log yet; start it first" >&2; exit 1; }
        exec tail -f "$LOGFILE" ;;
  backup) exec "$BACKEND/.venv/bin/python" "$BACKEND/tools/backup.py" ;;
  doctor)
    bad=0
    if [ -x "$BACKEND/.venv/bin/python" ]; then echo "venv      ok"
    else echo "venv      MISSING  python3 -m venv $BACKEND/.venv && $BACKEND/.venv/bin/pip install -r $BACKEND/requirements.txt"; bad=1; fi
    if [ -f "$ENVFILE" ]; then echo ".env      ok"
    else echo ".env      MISSING  hired setup"; bad=1; fi
    if [ -f "$BACKEND/hired.db" ]; then echo "database  ok  $(du -h "$BACKEND/hired.db" | cut -f1)"
    else echo "database  MISSING  it is created on first start"; fi
    if browser; then echo "chromium  ok  $PLAYWRIGHT_BROWSERS_PATH"
    else echo "chromium  MISSING  hired start installs it"; bad=1; fi
    if deps; then echo "node deps ok"
    else echo "node deps MISSING  cd $ROOT/frontend && pnpm install"; bad=1; fi
    if [ -f "$BUNDLE/index.html" ]; then echo "bundle    ok"
    else echo "bundle    missing, hired start builds it"; fi
    exit $bad ;;
  restart) stop; DEV= ;;
  dev)  DEV=1 ;;
  demo)
    # In memory, so it resets every launch and cannot reach the real database.
    # A second port so it runs beside the real instance rather than replacing it.
    export HIRED_DEMO=1 HIRED_DATABASE_URL="sqlite://" HIRED_PORT="${HIRED_DEMO_PORT:-8001}"
    export HIRED_SECRET_KEY="demo-only-not-a-secret"
    export HIRED_GEMINI_API_KEY="" HIRED_OPENROUTER_API_KEY="" OPEN_ROUTER_API_KEY="" GEMINI_API_KEY=""
    export HIRED_PASSWORD_HASH="$("$BACKEND/.venv/bin/python" -c 'import sys; sys.path.insert(0,"'"$BACKEND"'"); from app.auth import hash_password; from app.demo import PASSWORD; print(hash_password(PASSWORD))')"
    PORT="$HIRED_PORT"
    URL="http://127.0.0.1:$PORT"
    PIDFILE="$BACKEND/.hired-demo.pid"
    LOGFILE="$BACKEND/.hired-demo.log"
    DEV=
    # Always restart. The database is in memory, so a running demo is holding
    # old code and old data, and "already running" would quietly serve both.
    stop
    echo "demo mode on $URL   password: demo"
    ;;
  start) DEV= ;;
esac

if running; then
  echo "already running on $URL"
  open_url "$URL"
  exit 0
fi
rm -f "$PIDFILE"

[ -f "$ENVFILE" ] || { echo "No backend/.env yet. Run: hired setup" >&2; exit 1; }

# Install Chromium up front so PDF export does not fail later.
if ! browser; then
  echo "chromium is missing. Downloading into $PLAYWRIGHT_BROWSERS_PATH (~100MB, once)..."
  "$BACKEND/.venv/bin/playwright" install chromium || {
    echo "could not install it. Run: $BACKEND/.venv/bin/playwright install chromium" >&2
    exit 1
  }
  browser || { echo "chromium installed but will not launch." >&2; exit 1; }
fi

# Rebuild the frontend only when sources are newer than the bundle.
if [ ! -f "$BUNDLE/index.html" ] || [ -n "$(find "$ROOT/frontend/src" -newer "$BUNDLE/index.html" -print -quit)" ]; then
  if ! deps; then
    echo "installing front-end dependencies (once)..."
    (cd "$ROOT/frontend" && pnpm install) || {
      echo "pnpm install failed. Run it in $ROOT/frontend and try again." >&2
      exit 1
    }
    deps || { echo "pnpm install ran but ng is still missing." >&2; exit 1; }
  fi
  echo "building the front end..."
  (cd "$ROOT/frontend" && ./node_modules/.bin/ng build --configuration production >/dev/null) || {
    echo "the front-end build failed. Run it in $ROOT/frontend to see why." >&2
    exit 1
  }
fi

cd "$BACKEND"
: > "$LOGFILE"
.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$PORT" >>"$LOGFILE" 2>&1 &
echo $! > "$PIDFILE"

if wait_up 100; then
  open_url "$URL"
  echo "hired is up on $URL   (hired stop | hired log)"
  [ -n "$DEV" ] && (cd "$ROOT/frontend" && exec ./node_modules/.bin/ng serve --open)
  exit 0
fi
if running; then echo "did not come up in 10s:" >&2; stop; else echo "it died on startup:" >&2; fi
tail -20 "$LOGFILE" >&2
exit 1
