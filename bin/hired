#!/usr/bin/env bash
#
# Start hired and open it. Run from anywhere. `hired help` lists the commands;
# usage() below is the one copy of that list, so it cannot drift from the code.

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
BACKEND="$ROOT/backend"
BUNDLE="$ROOT/frontend/dist/hired/browser"
PORT="${HIRED_PORT:-8000}"
URL="http://127.0.0.1:$PORT"
PIDFILE="$BACKEND/.hired.pid"
LOGFILE="$BACKEND/.hired.log"

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

stop() {
  if running; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    # Give uvicorn a moment to close the database before anyone reopens it.
    for _ in $(seq 20); do running || break; sleep 0.1; done
    running && kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
}

usage() {
  cat <<TXT
hired — tailor a CV to a job posting, on your own machine.

  hired            start it and open the browser
                   (already running? just opens the tab)
  hired stop       stop it
  hired restart    stop, then start
  hired status     is it up, and on what
  hired log        follow the log, Ctrl-C to stop watching
  hired dev        start it, then ng serve on 4200 for front-end work
  hired backup     copy the database and profile into backend/backups
  hired help       this

How it runs
  One process on one port: FastAPI serves the built Angular bundle, so
  there is no separate front-end server and no CORS. The front end is
  rebuilt only when frontend/src is newer than the last build.

  It listens on 127.0.0.1 only, so nothing else on your network can
  reach it. The database holds your profile and every CV you have sent.

  Port $PORT, override with HIRED_PORT. Secrets come from
  backend/.env and are never passed on the command line.

  Repo   $ROOT
  Log    $LOGFILE
TXT
}

status() {
  if running; then
    echo "running on $URL   (pid $(cat "$PIDFILE"))"
  else
    echo "not running"
  fi
}

case "${1:-start}" in
  stop) stop; echo "stopped"; exit 0 ;;
  status) status; exit 0 ;;
  log)  [ -f "$LOGFILE" ] || { echo "no log yet; start it first" >&2; exit 1; }
        exec tail -f "$LOGFILE" ;;
  backup) exec "$BACKEND/.venv/bin/python" "$BACKEND/tools/backup.py" ;;
  help|-h|--help) usage; exit 0 ;;
  restart) stop; DEV= ;;
  dev)  DEV=1 ;;
  start) DEV= ;;
  *) echo "hired: no such command '$1'" >&2; echo >&2; usage >&2; exit 2 ;;
esac

if running; then
  echo "already running on $URL"
  open "$URL" 2>/dev/null || true
  exit 0
fi
rm -f "$PIDFILE"

# The secret and the password hash live in .env, never in the shell or in
# your history. No .env means no session signing key, and the app refuses to
# start rather than inventing one.
[ -f "$BACKEND/.env" ] || { echo "No .env at $BACKEND. Copy .env.example and fill it in." >&2; exit 1; }

# Rebuild only when the sources are newer than the bundle. A no-op start
# should not cost an Angular build.
if [ ! -f "$BUNDLE/index.html" ] || [ -n "$(find "$ROOT/frontend/src" -newer "$BUNDLE/index.html" -print -quit)" ]; then
  echo "building the front end..."
  (cd "$ROOT/frontend" && npx ng build --configuration production >/dev/null)
fi

cd "$BACKEND"
: > "$LOGFILE"
.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$PORT" >>"$LOGFILE" 2>&1 &
echo $! > "$PIDFILE"

# Wait for it to answer rather than guessing at a sleep. /api/health needs no
# session, which is exactly what it is for.
for _ in $(seq 100); do
  if curl -fsS --max-time 1 "$URL/api/health" >/dev/null 2>&1; then
    open "$URL" 2>/dev/null || true
    echo "hired is up on $URL   (hired stop | hired log)"
    [ -n "$DEV" ] && (cd "$ROOT/frontend" && exec npx ng serve --open)
    exit 0
  fi
  running || { echo "it died on startup:" >&2; tail -20 "$LOGFILE" >&2; exit 1; }
  sleep 0.1
done

echo "did not come up in 10s:" >&2; tail -20 "$LOGFILE" >&2; stop; exit 1
