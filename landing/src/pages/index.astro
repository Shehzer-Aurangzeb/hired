---
import { Image } from 'astro:assets';
import '../styles/global.css';
import HeroDemo from '../components/HeroDemo.astro';
import Laptop from '../components/Laptop.astro';

import paste from '../assets/shots/paste.png';
import fit from '../assets/shots/fit.png';
import generate from '../assets/shots/generate.png';
import applications from '../assets/shots/applications.png';
import profile from '../assets/shots/profile.png';
import cv from '../assets/shots/cv.png';

const REPO = 'https://github.com/Shehzer-Aurangzeb/hired';

// Shots come from demo/capture.py; any 1440x900 image can replace one.
const steps = [
  {
    title: 'Write your profile once',
    body: 'One Markdown file: every project, the bullets you would defend, and what each project cannot claim. You write it. Nothing in it is generated.',
    shot: profile,
    alt: 'Profile screen listing projects, title variants, summaries and skills, with one blocked bullet flagged to verify.',
  },
  {
    title: 'Paste a posting',
    body: 'The whole job description, requirements and all. Nothing is saved until you decide to keep it.',
    shot: paste,
    alt: 'Generate screen with a pasted job description and a Check fit button.',
  },
  {
    title: 'Get a verdict first',
    body: 'A score out of ten, the reasons, and the gaps. Being told to skip a posting is the most useful answer it gives.',
    shot: fit,
    alt: 'Fit result: 8 out of 10, marked Apply, with the reasoning and one gap.',
  },
  {
    title: 'Review the page',
    body: 'Bullets picked from your pool, coverage per requirement, and a live preview of the exact PDF.',
    shot: generate,
    alt: 'Generated CV: requirement coverage, selected bullets and a Letter-size preview.',
  },
  {
    title: 'Track what you sent',
    body: 'Every posting you kept, applied to or not, with the CV that went out and what came back.',
    shot: applications,
    alt: 'Applications list with totals, reply rate, a pipeline bar and a table of companies and statuses.',
  },
];

const pipeline = [
  { label: 'Waiting', n: 3, color: '#3b6ea8' },
  { label: 'Replied', n: 1, color: '#a8690c' },
  { label: 'Interview', n: 1, color: '#0f7a62' },
  { label: 'Rejected', n: 1, color: '#b13a2e' },
  { label: 'Passed on', n: 2, color: '#b5aa90' },
];
const pipelineTotal = pipeline.reduce((sum, s) => sum + s.n, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>hired · CVs you can defend</title>
    <meta
      name="description"
      content="Paste a job description, get a fit verdict and a tailored one-page CV built only from bullets you wrote. The model picks ids. It never writes a sentence."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="top" data-top>
      <div class="wrap top-row">
        <a class="brand" href="/" aria-label="hired, home">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>hired</span>
        </a>
        <nav class="top-nav" aria-label="Sections">
          <a href="#how">How it works</a>
          <a href="#honest">Why it can't lie</a>
          <a href="#run">Run it</a>
          <a class="btn btn-primary btn-sm" href={REPO}>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ---------- hero ---------- -->
      <section class="hero">
        <div class="wrap">
          <div class="hero-copy">
            <p class="eyebrow" data-reveal>
              <span class="pulse" aria-hidden="true"></span>
              Open source · runs on your laptop · Gemini free tier
            </p>
            <h1 data-reveal style="--i:1">
              A tailored CV you can{' '}
              <span class="mark">defend<svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M3 9 C 50 3, 120 3, 197 8" /></svg></span>{' '}
              in the interview.
            </h1>
            <p class="lede" data-reveal style="--i:2">
              Paste a job description. hired tells you if it's worth applying, then builds a one-page CV
              from bullets <strong>you</strong> wrote. The model picks. It never writes.
            </p>
            <div class="cta" data-reveal style="--i:3">
              <a class="btn btn-primary btn-lg" href="#how">See how it works <span class="arrow" aria-hidden="true">→</span></a>
              <a class="btn btn-outline btn-lg" href={REPO}>View source</a>
            </div>
          </div>

          <div class="hero-demo" data-reveal style="--i:4">
            <HeroDemo />
          </div>
        </div>
      </section>

      <!-- ---------- the problem, shown ---------- -->
      <section class="problem">
        <div class="wrap">
          <div class="head" data-reveal>
            <p class="label">The problem</p>
            <h2>Most AI CVs read well until someone asks a follow-up.</h2>
          </div>

          <div class="versus">
            <article class="vs vs-bad" data-reveal style="--i:1">
              <p class="vs-tag">A typical AI rewrite</p>
              <p class="vs-bullet">
                <span class="flag">Spearheaded</span> a cross-functional initiative that boosted dashboard
                performance by <span class="flag">300%</span> and drove <span class="flag">$2M in new revenue</span>.
              </p>
              <ul class="notes">
                <li><span>Spearheaded</span> You were one of three engineers.</li>
                <li><span>300%</span> Nobody measured that.</li>
                <li><span>$2M</span> Where would that number come from?</li>
              </ul>
            </article>

            <article class="vs vs-good" data-reveal style="--i:2">
              <p class="vs-tag">The same work, from your file</p>
              <p class="vs-bullet">
                Virtualised the transactions table so 50,000-row ledgers scroll smoothly, cutting{' '}
                <span class="ok">p75 load time by 40%</span>.
              </p>
              <dl class="meta">
                <div><dt>id</dt><dd class="mono">ledgerline-virtual</dd></div>
                <div><dt>metric</dt><dd>measured · Datadog RUM, four weeks before and after</dd></div>
                <div><dt>cannot claim</dt><dd>Led the team. There was a manager.</dd></div>
              </dl>
            </article>
          </div>
        </div>
      </section>

      <!-- ---------- how it works ---------- -->
      <section id="how" class="how">
        <div class="wrap">
          <div class="head" data-reveal>
            <p class="label">How it works</p>
            <h2>Five screens. One evening per posting.</h2>
          </div>

          <div class="tour" data-tour>
            <ol class="steps">
              {
                steps.map((step, i) => (
                  <li class="step" data-step-index={i} data-active={i === 0 ? '' : undefined}>
                    <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                    </div>
                    <Laptop class="step-device">
                      <Image src={step.shot} widths={[640, 1080]} sizes="100vw" alt={step.alt} />
                    </Laptop>
                  </li>
                ))
              }
            </ol>

            <div class="stage" aria-hidden="true">
              <div class="stage-inner">
                <Laptop>
                  {
                    steps.map((step, i) => (
                      <Image
                        src={step.shot}
                        widths={[900, 1440]}
                        sizes="(min-width: 1184px) 640px, 55vw"
                        alt=""
                        class="shot"
                        data-shot={i}
                        data-active={i === 0 ? '' : undefined}
                      />
                    ))
                  }
                </Laptop>
                <div class="progress"><span data-progress></span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ---------- the ink band ---------- -->
      <section id="honest" class="honest">
        <div class="wrap">
          <div class="head" data-reveal>
            <p class="label">Why it can't make things up</p>
            <h2>The model returns ids, not sentences.</h2>
            <p class="sub">
              The page is assembled from your file after the model answers. Anything it invents has nowhere
              to go. Hover an id to follow it.
            </p>
          </div>

          <div class="proof" data-proof data-reveal style="--i:1">
            <svg class="wires" data-wires aria-hidden="true"></svg>

            <div class="code">
              <p class="code-head mono">master.md <span>you write this</span></p>
              <pre class="mono"><code><span class="k">### Ledgerline App</span>
<span class="k">claim_boundary:</span>
  <span class="k">cannot_claim:</span>
    - Led the team. There was a manager.
    - Any revenue number. Never measured.

<span class="k">bullets:</span>
  - <span class="k">id:</span> <span class="ref" data-id="ledgerline-virtual">ledgerline-virtual</span>
    <span class="k">text:</span> Virtualised the transactions table…
  - <span class="k">id:</span> <span class="ref" data-id="ledgerline-cache">ledgerline-cache</span>
    <span class="k">text:</span> Moved data fetching to TanStack…
  - <span class="k">id:</span> <span class="struck">ledgerline-ai</span>
    <span class="k">status:</span> <span class="blocked">blocked</span>  <span class="k"># never sent</span>
    <span class="k">text:</span> Built AI-assisted invoice…</code></pre>
            </div>

            <div class="code">
              <p class="code-head mono">Gemini's answer <span>all it can say</span></p>
              <pre class="mono"><code>{'{'}
  <span class="k">"title_id"</span>: "frontend",
  <span class="k">"sections"</span>: [{'{'}
    <span class="k">"project_id"</span>: "ledgerline-app",
    <span class="k">"bullet_ids"</span>: [
      <span class="ref" data-id="ledgerline-virtual" tabindex="0">"ledgerline-virtual"</span>,
      <span class="ref" data-id="ledgerline-cache" tabindex="0">"ledgerline-cache"</span>
    ]
  {'}'}]
{'}'}</code></pre>
            </div>
          </div>

          <ol class="rules">
            <li data-reveal style="--i:0">
              <span class="num mono">01</span>
              <h3>Ids, not prose</h3>
              <p>A model that can only point at sentences can't write a new one. An id that isn't in your file blocks the export.</p>
            </li>
            <li data-reveal style="--i:1">
              <span class="num mono">02</span>
              <h3>Blocked never leaves</h3>
              <p>Blocked bullets are cut from the pool before the call. The model never sees them.</p>
            </li>
            <li data-reveal style="--i:2">
              <span class="num mono">03</span>
              <h3>Checked after</h3>
              <p>Plain code checks the printed page for banned words, missing qualifiers and overflow.</p>
            </li>
          </ol>
        </div>
      </section>

      <!-- ---------- details ---------- -->
      <section class="details">
        <div class="wrap">
          <div class="head" data-reveal>
            <p class="label">The small things</p>
            <h2>Built for the fortieth application, not the first.</h2>
          </div>

          <div class="tiles">
            <article class="tile" data-reveal style="--i:0">
              <div class="viz viz-meter" aria-hidden="true">
                <div class="meter-num"><span>8</span>/10 <em>Apply</em></div>
                <div class="segments">{Array.from({ length: 10 }, (_, i) => <span class:list={{ fill: i < 8 }} style={`--d:${i}`} />)}</div>
              </div>
              <h3>A verdict before the work</h3>
              <p>Score, reasons and gaps in one call. Skip a posting with a clear conscience.</p>
            </article>

            <article class="tile" data-reveal style="--i:1">
              <div class="viz viz-chips" aria-hidden="true">
                {['React', 'TypeScript', 'GraphQL'].map((name, i) => (
                  <span class="vchip ok" style={`--d:${i}`}>✓ {name}</span>
                ))}
                <span class="vchip gap" style="--d:3">✕ React Native</span>
              </div>
              <h3>Coverage you can read</h3>
              <p>Every requirement, and the bullet that backs it. The empty ones are the useful ones.</p>
            </article>

            <article class="tile" data-reveal style="--i:2">
              <div class="viz viz-fill" aria-hidden="true">
                <div class="fill-row"><span>Page filled</span><strong>98%</strong></div>
                <div class="track"><span></span></div>
                <div class="fill-row small"><span>Letter · 8.5 × 11 in</span><span>1 page</span></div>
              </div>
              <h3>Exactly one page</h3>
              <p>Measured by the same renderer that prints the PDF. Topped up from your own priorities.</p>
            </article>

            <article class="tile" data-reveal style="--i:3">
              <div class="viz viz-pipe" aria-hidden="true">
                <div class="pipe">
                  {pipeline.map((s, i) => (
                    <span style={`--w:${(s.n / pipelineTotal) * 100}%;--c:${s.color};--d:${i}`} />
                  ))}
                </div>
                <div class="legend">
                  {pipeline.slice(0, 3).map((s) => (
                    <span><i style={`background:${s.color}`} />{s.label} {s.n}</span>
                  ))}
                </div>
              </div>
              <h3>A pipeline, not a spreadsheet</h3>
              <p>Every posting kept, applied to or not, with follow-up nudges after a week of silence.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- ---------- output ---------- -->
      <section class="output">
        <div class="wrap output-row">
          <div class="sheet-stack" data-tilt data-reveal>
            <Image
              src={cv}
              widths={[480, 816, 1200]}
              sizes="(min-width: 1024px) 460px, 90vw"
              alt="The exported one-page CV for the fictional Maya Okafor, tailored to a senior front-end posting."
              class="sheet"
            />
          </div>
          <div class="output-text">
            <p class="label" data-reveal>The output</p>
            <h2 data-reveal style="--i:1">One page. Measured, not hoped.</h2>
            <p class="sub" data-reveal style="--i:2">
              The renderer prints the page and measures it. A thin page is topped up from your own priority
              order, one bullet at a time, and stops before it spills onto a second. The PDF is saved next to
              the posting that produced it.
            </p>
            <dl class="facts" data-reveal style="--i:3">
              <div><dt>Format</dt><dd>Letter PDF, Inter</dd></div>
              <div><dt>Bullets</dt><dd>Copied from your file</dd></div>
              <div><dt>Coverage</dt><dd>Per requirement, gaps included</dd></div>
              <div><dt>Saved with</dt><dd>The posting that produced it</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- ---------- run ---------- -->
      <section id="run" class="run">
        <div class="wrap">
          <div class="run-card" data-reveal>
            <div class="run-copy">
              <p class="label">Run it</p>
              <h2>One command. One port. Your machine.</h2>
              <p class="sub">
                Docker or a local Python setup, and the same <code class="mono">hired</code> command either
                way. <code class="mono">hired setup</code> asks for a password and a free Gemini key, then the
                app listens on 127.0.0.1 only, so nothing else on your network can reach it.
              </p>
              <ul class="needs">
                <li>Docker</li>
                <li class="or">or</li>
                <li>Python 3 · Node 20+ · pnpm</li>
              </ul>
              <a class="btn btn-primary btn-lg" href={REPO}>Get it on GitHub <span class="arrow" aria-hidden="true">→</span></a>
            </div>
            <div class="terminal" data-terminal>
              <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span class="mono">zsh</span></div>
              <pre class="mono"><code><span data-line="$ git clone https://github.com/Shehzer-Aurangzeb/hired"></span>
<span data-line="$ cd hired"></span>
<span data-line="$ ln -s &quot;$PWD/bin/hired&quot; ~/.local/bin/hired"></span>
<span data-line="$ hired setup"></span>
<span data-line="$ hired"></span>
<span class="t-dim" data-line="starting in docker (the first build takes a few minutes)..." data-instant></span>
<span class="t-ok" data-line="✓ hired is up on http://127.0.0.1:8000" data-instant></span></code></pre>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-row">
        <span class="brand small">
          <img src="/favicon.svg" alt="" width="20" height="20" />
          hired
        </span>
        <span>Built by Shehzar for his own job hunt. Screenshots use a fictional profile.</span>
        <a href={REPO}>GitHub</a>
      </div>
    </footer>

    <script>
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const reveal = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('in');
            reveal.unobserve(entry.target);
          }),
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

      const top = document.querySelector('[data-top]');
      const onScroll = () => top?.classList.toggle('scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // The step crossing mid-screen picks the laptop screenshot.
      const tour = document.querySelector('[data-tour]');
      if (tour) {
        const steps = [...tour.querySelectorAll<HTMLElement>('[data-step-index]')];
        const shots = [...tour.querySelectorAll<HTMLElement>('[data-shot]')];
        const bar = tour.querySelector<HTMLElement>('[data-progress]');
        const show = (index: number) => {
          steps.forEach((s, i) => s.toggleAttribute('data-active', i === index));
          shots.forEach((s, i) => s.toggleAttribute('data-active', i === index));
          bar?.style.setProperty('--p', String((index + 1) / steps.length));
        };
        const watch = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) show(Number((entry.target as HTMLElement).dataset.stepIndex));
            }),
          { rootMargin: '-45% 0px -45% 0px' },
        );
        steps.forEach((s) => watch.observe(s));
        show(0);
      }

      // Highlight matching ids in both panes; draw connecting lines on wide screens.
      const proof = document.querySelector<HTMLElement>('[data-proof]');
      if (proof) {
        const refs = [...proof.querySelectorAll<HTMLElement>('[data-id]')];
        refs.forEach((ref) => {
          const twins = proof.querySelectorAll(`[data-id="${ref.dataset.id}"]`);
          const light = (on: boolean) => {
            twins.forEach((t) => t.classList.toggle('lit', on));
            proof.querySelector(`path[data-for="${ref.dataset.id}"]`)?.classList.toggle('lit', on);
          };
          ref.addEventListener('mouseenter', () => light(true));
          ref.addEventListener('mouseleave', () => light(false));
          ref.addEventListener('focus', () => light(true));
          ref.addEventListener('blur', () => light(false));
        });

        const svg = proof.querySelector<SVGSVGElement>('[data-wires]')!;
        const draw = () => {
          const box = proof.getBoundingClientRect();
          const ids = [...new Set(refs.map((r) => r.dataset.id!))];
          svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
          svg.innerHTML = ids
            .map((id) => {
              const [from, to] = refs.filter((r) => r.dataset.id === id).map((r) => r.getBoundingClientRect());
              // No line when the panes are stacked.
              if (!from || !to || to.left < from.right) return '';
              const x1 = from.right - box.left + 6;
              const y1 = from.top + from.height / 2 - box.top;
              const x2 = to.left - box.left - 6;
              const y2 = to.top + to.height / 2 - box.top;
              const mid = (x1 + x2) / 2;
              return `<path data-for="${id}" pathLength="1" d="M${x1} ${y1} C ${mid} ${y1}, ${mid} ${y2}, ${x2} ${y2}" />`;
            })
            .join('');
        };
        draw();
        addEventListener('resize', draw);
        document.fonts?.ready.then(draw);
      }

      const tilt = document.querySelector<HTMLElement>('[data-tilt]');
      if (tilt && !reduced && matchMedia('(hover: hover)').matches) {
        tilt.addEventListener('pointermove', (e) => {
          const r = tilt.getBoundingClientRect();
          tilt.style.setProperty('--rx', `${((e.clientY - r.top) / r.height - 0.5) * -6}deg`);
          tilt.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 8}deg`);
        });
        tilt.addEventListener('pointerleave', () => {
          tilt.style.setProperty('--rx', '0deg');
          tilt.style.setProperty('--ry', '0deg');
        });
      }

      const term = document.querySelector<HTMLElement>('[data-terminal]');
      if (term) {
        const lines = [...term.querySelectorAll<HTMLElement>('[data-line]')];
        const fill = () => lines.forEach((l) => (l.textContent = l.dataset.line!));
        if (reduced) fill();
        else {
          new IntersectionObserver((entries, observer) => {
            if (!entries[0].isIntersecting) return;
            observer.disconnect();
            let t = 300;
            lines.forEach((line) => {
              const text = line.dataset.line!;
              if (line.hasAttribute('data-instant')) {
                t += 600;
                setTimeout(() => (line.textContent = text), t);
                return;
              }
              for (let i = 0; i <= text.length; i += 2) {
                setTimeout(() => (line.textContent = text.slice(0, i)), t + i * 14);
              }
              setTimeout(() => (line.textContent = text), t + text.length * 14);
              t += text.length * 14 + 350;
            });
          }, { threshold: 0.5 }).observe(term);
        }
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 16px;
        top: 16px;
        z-index: 30;
        padding: 8px 12px;
        background: var(--ink);
        color: var(--ink-fg);
        border-radius: 6px;
      }

      /* ---------- shared ---------- */
      section {
        position: relative;
      }
      .head {
        max-width: 720px;
      }
      h2 {
        margin-top: 12px;
        font-size: clamp(30px, 4.4vw, 50px);
        line-height: 1.05;
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .sub {
        margin-top: 16px;
        max-width: 60ch;
        font-size: 17px;
        color: var(--fg-muted);
      }
      .num {
        font-size: 13px;
        color: var(--fg-subtle);
      }
      .btn-sm {
        min-height: 36px;
        padding: 0 14px;
        font-size: 14px;
      }
      .btn-lg {
        min-height: 50px;
        padding: 0 22px;
        font-size: 16px;
      }

      /* ---------- header ---------- */
      .top {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid transparent;
        transition: background-color 200ms, border-color 200ms;
      }
      .top.scrolled {
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(10px) saturate(1.2);
        border-bottom-color: var(--line);
      }
      .top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--display);
        font-weight: 700;
        font-size: 20px;
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .brand img {
        border-radius: 7px;
      }
      .top-nav {
        display: flex;
        align-items: center;
        gap: 28px;
        font-size: 14px;
      }
      .top-nav a:not(.btn) {
        color: var(--fg-muted);
        text-decoration: none;
        transition: color 150ms;
      }
      .top-nav a:not(.btn):hover {
        color: var(--fg);
      }
      @media (max-width: 767px) {
        .top-nav a:not(.btn) {
          display: none;
        }
      }

      /* ---------- hero ---------- */
      .hero {
        padding: 64px 0 120px;
        overflow-x: clip;
      }
      .hero::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 360px;
        width: min(1100px, 120vw);
        height: 600px;
        transform: translateX(-50%);
        background: radial-gradient(closest-side, rgb(255 252 244 / 0.9), transparent);
        pointer-events: none;
      }
      .hero-copy {
        position: relative;
        display: grid;
        justify-items: center;
        text-align: center;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px;
        background: var(--raised);
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 13px;
        color: var(--fg-muted);
      }
      .pulse {
        position: relative;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
      }
      .pulse::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: var(--accent);
        animation: pulse 2.4s ease-out infinite;
      }
      @keyframes pulse {
        to {
          transform: scale(3);
          opacity: 0;
        }
      }
      h1 {
        margin-top: 28px;
        max-width: 14ch;
        font-size: clamp(44px, 8vw, 92px);
        line-height: 0.98;
        font-weight: 700;
        letter-spacing: -0.045em;
      }
      .mark {
        position: relative;
        display: inline-block;
        color: var(--accent);
      }
      .mark svg {
        position: absolute;
        left: 0;
        bottom: -0.08em;
        width: 100%;
        height: 0.18em;
        overflow: visible;
      }
      .mark path {
        fill: none;
        stroke: var(--accent);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
      }
      .in .mark path,
      :global(html:not(.js)) .mark path {
        animation: draw 900ms 600ms cubic-bezier(0.6, 0, 0.2, 1) forwards;
      }
      @keyframes draw {
        to {
          stroke-dashoffset: 0;
        }
      }
      .lede {
        margin-top: 28px;
        max-width: 56ch;
        font-size: clamp(17px, 2vw, 20px);
        color: var(--fg-muted);
      }
      .lede strong {
        color: var(--fg);
      }
      .cta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 36px;
      }
      .hero-demo {
        position: relative;
        margin-top: 72px;
      }

      /* ---------- problem ---------- */
      .problem {
        padding: 120px 0;
        background: var(--raised);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .versus {
        display: grid;
        gap: 20px;
        margin-top: 56px;
      }
      @media (min-width: 900px) {
        .versus {
          grid-template-columns: 1fr 1fr;
        }
      }
      .vs {
        padding: 28px;
        border-radius: 12px;
        border: 1px solid var(--line);
      }
      .vs-bad {
        background: var(--bg);
      }
      .vs-good {
        background: #fff;
        border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
        box-shadow: 0 30px 60px -40px rgb(47 107 79 / 0.45);
      }
      .vs-tag {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fg-subtle);
      }
      .vs-good .vs-tag {
        color: var(--accent);
      }
      .vs-bullet {
        margin-top: 16px;
        font-size: clamp(19px, 2.2vw, 23px);
        line-height: 1.45;
        font-weight: 500;
        letter-spacing: -0.01em;
      }
      .vs-bad .vs-bullet {
        color: var(--fg-muted);
      }
      .flag,
      .ok {
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0% 2px;
        transition: background-size 700ms cubic-bezier(0.6, 0, 0.2, 1) 500ms;
        padding-bottom: 2px;
      }
      .flag {
        color: var(--danger);
        background-image: linear-gradient(var(--danger), var(--danger));
      }
      .ok {
        color: var(--accent);
        background-image: linear-gradient(var(--accent), var(--accent));
      }
      .in .flag,
      .in .ok,
      :global(html:not(.js)) .flag,
      :global(html:not(.js)) .ok {
        background-size: 100% 2px;
      }
      .notes {
        list-style: none;
        margin: 24px 0 0;
        padding: 0;
        display: grid;
        gap: 8px;
        font-size: 14px;
        color: var(--fg-muted);
      }
      .notes li {
        display: flex;
        gap: 12px;
      }
      .notes span {
        flex: 0 0 96px;
        color: var(--danger);
        font-weight: 600;
      }
      .meta {
        margin: 24px 0 0;
        display: grid;
        gap: 8px;
        font-size: 14px;
      }
      .meta div {
        display: flex;
        gap: 12px;
      }
      .meta dt {
        flex: 0 0 96px;
        color: var(--fg-subtle);
      }
      .meta dd {
        margin: 0;
        color: var(--fg);
      }
      .meta .mono {
        font-size: 13px;
        color: var(--accent);
      }

      /* ---------- how it works ---------- */
      .how {
        padding: 120px 0;
      }
      .tour {
        margin-top: 56px;
      }
      .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 48px;
      }
      .step {
        display: grid;
        grid-template-columns: 36px 1fr;
        gap: 4px 12px;
      }
      .step p {
        margin-top: 8px;
        color: var(--fg-muted);
      }
      .step .num {
        padding-top: 4px;
      }
      .step :global(.step-device) {
        grid-column: 1 / -1;
        margin-top: 20px;
      }
      .stage {
        display: none;
      }

      @media (min-width: 1024px) {
        .tour {
          display: grid;
          grid-template-columns: 340px 1fr;
          gap: 64px;
        }
        .steps {
          gap: 0;
          padding: 0 0 12vh;
        }
        .step {
          min-height: 62vh;
          align-content: center;
          opacity: 0.35;
          transition: opacity 300ms;
        }
        .step[data-active] {
          opacity: 1;
        }
        .step[data-active] .num {
          color: var(--accent);
          font-weight: 600;
        }
        .step :global(.step-device) {
          display: none;
        }
        .stage {
          display: block;
        }
        .stage-inner {
          position: sticky;
          top: calc(50vh - 230px);
        }
        .stage :global(.shot) {
          opacity: 0;
          transform: scale(1.015);
          transition:
            opacity 450ms ease-out,
            transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        .stage :global(.shot[data-active]) {
          opacity: 1;
          transform: none;
        }
        .progress {
          height: 3px;
          margin: 28px 12% 0;
          border-radius: 3px;
          background: var(--line);
          overflow: hidden;
        }
        .progress span {
          display: block;
          height: 100%;
          background: var(--accent);
          transform-origin: left;
          transform: scaleX(var(--p, 0.2));
          transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
        }
      }

      /* ---------- ink band ---------- */
      .honest {
        padding: 120px 0;
        background: var(--ink);
        color: var(--ink-fg);
      }
      .honest .label,
      .honest .sub,
      .honest .num,
      .rules p {
        color: var(--ink-muted);
      }
      .proof {
        position: relative;
        display: grid;
        gap: 16px;
        margin-top: 56px;
      }
      @media (min-width: 900px) {
        .proof {
          grid-template-columns: 1.1fr 1fr;
          gap: 72px;
        }
      }
      .wires {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
        z-index: 1;
      }
      .wires :global(path) {
        fill: none;
        stroke: #6fcf97;
        stroke-width: 1.5;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        opacity: 0.7;
        transition:
          stroke-dashoffset 1100ms cubic-bezier(0.6, 0, 0.2, 1) 400ms,
          opacity 200ms,
          stroke-width 200ms;
      }
      .proof.in .wires :global(path) {
        stroke-dashoffset: 0;
      }
      .wires :global(path.lit) {
        opacity: 1;
        stroke-width: 2.5;
      }
      .code {
        min-width: 0;
        border: 1px solid #3a342a;
        border-radius: 10px;
        background: #221e17;
      }
      .code-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid #3a342a;
        font-size: 12px;
      }
      .code-head span {
        color: var(--ink-muted);
      }
      .code pre {
        margin: 0;
        padding: 18px;
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.75;
        color: #ddd4c0;
      }
      .k {
        color: var(--ink-muted);
      }
      .blocked {
        color: #e8a598;
      }
      .struck {
        text-decoration: line-through;
        text-decoration-color: #e8a598;
        color: #8a8070;
      }
      .ref {
        padding: 1px 4px;
        margin: 0 -4px;
        border-radius: 4px;
        color: #a9d4bb;
        transition: background-color 150ms, color 150ms;
      }
      .ref.lit {
        background: var(--accent-soft);
        color: var(--ink);
      }
      .rules {
        list-style: none;
        margin: 64px 0 0;
        padding: 0;
        display: grid;
        gap: 32px;
      }
      @media (min-width: 768px) {
        .rules {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .rules li {
        padding-top: 20px;
        border-top: 1px solid #3a342a;
      }
      .rules h3 {
        margin-top: 10px;
      }
      .rules p {
        margin-top: 6px;
        font-size: 15px;
      }

      /* ---------- details ---------- */
      .details {
        padding: 120px 0 40px;
      }
      .tiles {
        display: grid;
        gap: 16px;
        margin-top: 56px;
      }
      @media (min-width: 700px) {
        .tiles {
          grid-template-columns: 1fr 1fr;
        }
      }
      @media (min-width: 1100px) {
        .tiles {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .tile {
        padding: 20px;
        background: var(--raised);
        border: 1px solid var(--line);
        border-radius: 12px;
        transition:
          opacity 600ms ease-out,
          transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1),
          border-color 200ms,
          box-shadow 200ms;
        transition-delay: calc(var(--i, 0) * 70ms), calc(var(--i, 0) * 70ms), 0ms, 0ms;
      }
      .tile:hover {
        border-color: var(--line-strong);
        box-shadow: 0 20px 40px -28px rgb(60 45 20 / 0.45);
      }
      .tile h3 {
        margin-top: 20px;
        font-size: 16px;
      }
      .tile p {
        margin-top: 6px;
        font-size: 14px;
        line-height: 1.55;
        color: var(--fg-muted);
      }
      .viz {
        min-height: 128px;
        padding: 16px;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 8px;
        display: grid;
        align-content: center;
        gap: 12px;
      }
      .meter-num {
        font-size: 14px;
        color: var(--fg-muted);
      }
      .meter-num span {
        font-family: var(--display);
        font-size: 32px;
        font-weight: 700;
        color: var(--accent);
      }
      .meter-num em {
        margin-left: 8px;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 11px;
        font-style: normal;
        font-weight: 600;
      }
      .segments {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 4px;
      }
      .segments span {
        height: 10px;
        border-radius: 2px;
        background: var(--line);
      }
      .segments .fill {
        transition: background-color 200ms calc(400ms + var(--d) * 60ms);
      }
      .in .segments .fill,
      :global(html:not(.js)) .segments .fill {
        background: var(--accent);
      }
      .viz-chips {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        gap: 6px;
      }
      .vchip {
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 12px;
        transition:
          opacity 300ms ease-out calc(400ms + var(--d) * 90ms),
          transform 400ms cubic-bezier(0.3, 1.5, 0.5, 1) calc(400ms + var(--d) * 90ms);
      }
      :global(.js) .tile:not(.in) .vchip {
        opacity: 0;
        transform: scale(0.85);
      }
      .vchip.ok {
        background: var(--accent-soft);
        color: var(--accent);
      }
      .vchip.gap {
        background: var(--warn-soft);
        color: var(--warn);
      }
      .fill-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: var(--fg-muted);
      }
      .fill-row strong {
        font-family: var(--display);
        font-size: 22px;
        color: var(--fg);
      }
      .fill-row.small {
        font-size: 11px;
      }
      .track {
        height: 8px;
        border-radius: 8px;
        background: var(--line);
        overflow: hidden;
      }
      .track span {
        display: block;
        height: 100%;
        width: 98%;
        background: var(--accent);
        border-radius: 8px;
        transform-origin: left;
        transition: transform 1200ms cubic-bezier(0.2, 0.8, 0.2, 1) 400ms;
      }
      :global(.js) .tile:not(.in) .track span {
        transform: scaleX(0);
      }
      .pipe {
        display: flex;
        gap: 3px;
        height: 22px;
      }
      .pipe span {
        width: var(--w);
        border-radius: 3px;
        background: var(--c);
        transform-origin: left;
        transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(400ms + var(--d) * 120ms);
      }
      :global(.js) .tile:not(.in) .pipe span {
        transform: scaleX(0);
      }
      .pipe span:last-child {
        background: repeating-linear-gradient(-45deg, var(--c) 0 4px, transparent 4px 8px);
      }
      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 12px;
        font-size: 11px;
        color: var(--fg-muted);
      }
      .legend i {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 5px;
        border-radius: 50%;
      }

      /* ---------- output ---------- */
      .output {
        padding: 120px 0;
        overflow-x: clip;
      }
      .output-row {
        display: grid;
        gap: 64px;
        align-items: center;
      }
      @media (min-width: 1024px) {
        .output-row {
          grid-template-columns: 460px 1fr;
          gap: 88px;
        }
      }
      .sheet-stack {
        position: relative;
        max-width: 460px;
        width: 100%;
        margin: 0 auto;
        perspective: 1200px;
      }
      .sheet-stack::before,
      .sheet-stack::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--raised);
        border: 1px solid var(--line);
        border-radius: 4px;
        transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .sheet-stack::before {
        transform: rotate(-4deg) translate(-10px, 10px);
      }
      .sheet-stack::after {
        transform: rotate(2.5deg) translate(12px, 6px);
      }
      .sheet-stack:hover::before {
        transform: rotate(-6deg) translate(-22px, 14px);
      }
      .sheet-stack:hover::after {
        transform: rotate(4deg) translate(24px, 8px);
      }
      .sheet-stack :global(.sheet) {
        position: relative;
        z-index: 1;
        border: 1px solid var(--line);
        border-radius: 4px;
        box-shadow: 0 40px 80px -40px rgb(60 45 20 / 0.5);
        transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
        transition: transform 300ms ease-out;
      }
      .facts {
        margin: 36px 0 0;
        border-top: 1px solid var(--line-strong);
      }
      .facts div {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
        font-size: 15px;
      }
      .facts dt {
        color: var(--fg-muted);
      }
      .facts dd {
        margin: 0;
        font-weight: 500;
        text-align: right;
      }

      /* ---------- run ---------- */
      .run {
        padding: 0 0 120px;
      }
      .run-card {
        display: grid;
        gap: 40px;
        padding: clamp(24px, 5vw, 56px);
        background: var(--raised);
        border: 1px solid var(--line);
        border-radius: 20px;
        box-shadow: 0 40px 80px -60px rgb(60 45 20 / 0.5);
      }
      @media (min-width: 1024px) {
        .run-card {
          grid-template-columns: 1fr 1.1fr;
          gap: 56px;
          align-items: center;
        }
      }
      .run-copy code {
        font-size: 0.9em;
        padding: 1px 5px;
        border-radius: 4px;
        background: var(--surface);
        color: var(--fg);
      }
      .needs {
        list-style: none;
        margin: 20px 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 13px;
      }
      .needs li:not(.or) {
        padding: 4px 12px;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        color: var(--fg);
      }
      .needs .or {
        color: var(--fg-subtle);
      }
      .run-copy .btn {
        margin-top: 28px;
      }
      .terminal {
        min-width: 0;
        overflow: hidden;
        background: var(--ink);
        color: var(--ink-fg);
        border-radius: 12px;
        box-shadow: 0 30px 60px -30px rgb(26 23 18 / 0.6);
      }
      .term-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border-bottom: 1px solid #3a342a;
      }
      .term-bar i {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #3a342a;
      }
      .term-bar span {
        margin-left: auto;
        font-size: 11px;
        color: var(--ink-muted);
      }
      .terminal pre {
        margin: 0;
        /* Every line's height reserved up front, so typing never pushes the card. */
        min-height: 240px;
        padding: 20px;
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.9;
      }
      @media (max-width: 639px) {
        .terminal pre {
          font-size: 11.5px;
          padding: 16px;
        }
      }
      .t-dim {
        color: var(--ink-muted);
      }
      .t-ok {
        color: #6fcf97;
      }

      /* ---------- footer ---------- */
      .foot {
        border-top: 1px solid var(--line);
        font-size: 14px;
        color: var(--fg-muted);
      }
      .foot-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px 24px;
        padding-top: 28px;
        padding-bottom: 28px;
      }
      .brand.small {
        font-size: 16px;
        color: var(--fg);
      }
      .brand.small img {
        border-radius: 5px;
      }
    </style>
  </body>
</html>
