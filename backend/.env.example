# `hired setup` creates backend/.env from this and fills in the first three.

# Signs the session cookie: python -c "import secrets; print(secrets.token_urlsafe(48))"
HIRED_SECRET_KEY=

# Login password hash, in single quotes (empty refuses all logins).
HIRED_PASSWORD_HASH=

# SQLAlchemy URL; a postgresql+psycopg:// URL also works.
HIRED_DATABASE_URL=sqlite:///./hired.db

# For real deployments set secure=true; samesite=none requires it.
HIRED_COOKIE_SECURE=false
HIRED_COOKIE_SAMESITE=lax

# JSON list of exact frontend origins ("*" is not allowed with credentials).
HIRED_CORS_ORIGINS=["http://localhost:4200"]

# Optional overrides for app/profile_template.py; the briefing may contain {template}.
HIRED_PROFILE_TEMPLATE=
HIRED_CLAUDE_BRIEFING=

# Google AI Studio key (GEMINI_API_KEY also accepted).
HIRED_GEMINI_API_KEY=

# Gemini model name; change it when Google retires one.
HIRED_GEMINI_MODEL=gemini-3.6-flash

# Fallback when Gemini fails: a model on this machine, through ollama. No key,
# no quota. Blank it to turn the fallback off.
#   ollama pull granite3.3:8b
HIRED_OLLAMA_MODEL=granite3.3:8b

# Existing Chrome/Chromium path; empty uses Playwright's download.
HIRED_CHROME_PATH=
