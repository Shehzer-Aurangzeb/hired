# Copy to backend/.env (gitignored) and fill in. Both secrets are per-deployment.

# Signs the session cookie. Rotating it signs everyone out, which is the point.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HIRED_SECRET_KEY=

# scrypt hash of the one password guarding the instance. Generate it with:
#   cd backend && .venv/bin/python -m app.hash_password
# Left empty, every login is refused rather than let through.
HIRED_PASSWORD_HASH=

# sqlite:///./hired.db locally. A postgresql+psycopg:// URL works unchanged.
HIRED_DATABASE_URL=sqlite:///./hired.db

# Set both for a real deployment. samesite=none also requires secure=true.
HIRED_COOKIE_SECURE=false
HIRED_COOKIE_SAMESITE=lax

# JSON list. The frontend origin, exactly: credentialed CORS forbids "*".
HIRED_CORS_ORIGINS=["http://localhost:4200"]

# Both optional. Empty uses the defaults in app/profile_template.py, so these
# exist to reword the starter file or the Claude briefing without a code change.
# The briefing may contain {template}; without it the template is appended.
HIRED_PROFILE_TEMPLATE=
HIRED_CLAUDE_BRIEFING=

# Google AI Studio, for the fit check and the selector. GEMINI_API_KEY without
# the prefix is accepted too, since that is the name Google's own tooling uses.
# Empty means every model-backed route answers 503 rather than half working.
HIRED_GEMINI_API_KEY=

# gemini-2.5-flash is retired for new keys. Free tier is billed in requests per
# day, not tokens, and one fit check is ~2.5k tokens, so the model is chosen for
# judgement rather than for size.
HIRED_GEMINI_MODEL=gemini-3.6-flash

# OpenRouter, tried before Gemini when set. Requests go to openrouter/free,
# which routes across whatever free models are up, so there is no model list to
# keep current. Free tier is 20 requests a minute and 50 a day with no credits,
# 1000 a day once $10 has ever been bought. OPEN_ROUTER_API_KEY works too.
HIRED_OPENROUTER_API_KEY=

# Empty uses the Chromium that `playwright install chromium` downloads. Set it
# when the host already has one and a second 150MB copy buys nothing.
HIRED_CHROME_PATH=
